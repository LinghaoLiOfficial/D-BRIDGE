# OpenAI-compatible chat completion endpoint. Keep secrets in .env only.
API_KEY=replace-me
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
TEMPERATURE=0
ENABLE_THINKING=false
TIMEOUT=60
MAX_RETRIES=2
CONCEPT_EXTRACTION_CONCURRENCY=3

# OpenAI-compatible embedding endpoint
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# Experiment parameters
DATA_DIR=data
RESULT_DIR=result
PROMPT_TEMPLATE_PATH=config/prompt_templates.json
EXPERIMENT_SEEDS=[42]
SAMPLE_SIZE=5
TIME_BINS=2
HOTNESS_BINS=2
SIMILARITY_TOP_K=5
SIMILARITY_THRESHOLD=0.35
NEO4J_BATCH_SIZE=100

# Local Neo4j Compose defaults
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-password
NEO4J_DATABASE=neo4j
